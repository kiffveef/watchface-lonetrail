{
  "name": "lonetrail",
  "author": "kiffveef",
  "version": "0.1.0",
  "keywords": [
    "pebble-app"
  ],
  "private": true,
  "dependencies": {},
  "pebble": {
    "displayName": "Lonetrail",
    "uuid": "1b5f94df-5dff-49b3-bc95-54cc3dade94c",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "emery"
    ],
    "watchapp": {
      "watchface": true
    },
    "resources": {
      "media": [
        {
          "type": "font",
          "name": "FONT_INTER_REGULAR_12",
          "file": "fonts/Inter-Regular.ttf",
          "characterRegex": "[A-Za-z0-9 ]"
        },
        {
          "type": "font",
          "name": "FONT_INTER_BOLD_12",
          "file": "fonts/Inter-Bold.ttf",
          "characterRegex": "[0-9,-]"
        },
        {
          "type": "font",
          "name": "FONT_BARLOW_BOLD_48",
          "file": "fonts/Barlow-Bold.ttf",
          "characterRegex": "[0-9:]"
        },
        {
          "type": "font",
          "name": "FONT_INTER_REGULAR_16",
          "file": "fonts/Inter-Regular.ttf",
          "characterRegex": "[A-Za-z0-9 ]"
        }
      ]
    }
  }
}
